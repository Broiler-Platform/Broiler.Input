<?xml version="1.0" encoding="utf-8"?>
<!-- Restore configuration for NuGet.org releases (BroilerPackageSource=nuget).
     Every package, including upstream Broiler.* dependencies, comes from
     NuGet.org, so a release is built from exactly what its consumers restore
     and needs no GitHub Packages credentials. The default NuGet.config at the
     repository root maps Broiler.* to GitHub Packages instead. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
