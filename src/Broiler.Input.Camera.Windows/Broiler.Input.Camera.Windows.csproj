  <ItemGroup>
    <PackageReference Include="Broiler.Media.Video.MediaFoundation" Version="0.1.0-preview.10" />
    <PackageReference Include="Broiler.Media.Video.Windows" Version="0.1.0-preview.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Input.Camera\Broiler.Input.Camera.csproj" />
    <ProjectReference Include="..\Broiler.Input.Windows\Broiler.Input.Windows.csproj" />
  </ItemGroup>

</Project>
